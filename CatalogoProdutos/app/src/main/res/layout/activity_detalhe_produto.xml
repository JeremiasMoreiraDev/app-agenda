<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#00796B">

        <Button
            android:id="@+id/btnVoltar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00796B"
            android:contentDescription="Voltar ao catálogo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Detalhes do produto"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtDetalheNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#173D36"
                tools:text="Painel Solar - TESTE" />

            <TextView
                android:id="@+id/txtDetalheCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#555555"
                tools:text="Painéis solares" />

            <ImageView
                android:id="@+id/imgDetalheProduto"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/fundo_card_produto"
                android:padding="12dp"
                android:contentDescription="Foto do produto"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery" />

            <TextView
                android:id="@+id/txtDetalhePreco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#00796B"
                tools:text="R$ 500,00" />

            <TextView
                android:id="@+id/txtDetalheEstoque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:textColor="#555555"
                tools:text="Em estoque: 10 unidade(s)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Descrição"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#173D36" />

            <TextView
                android:id="@+id/txtDetalheDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#555555"
                tools:text="Produto fictício para testar o catálogo." />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionarCarrinho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="52dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Adicionar ao carrinho"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#00796B"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerCarrinho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Ver carrinho"
                android:textAllCaps="false"
                android:textColor="#00796B"
                android:textSize="16sp"
                android:backgroundTint="#E6F3F0"
                android:visibility="gone" />
            <Button

                android:id="@+id/btnEditarProduto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="52dp"
                android:text="Editar produto"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00796B" />
            <Button
                android:id="@+id/btnDesativarProduto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="Desativar produto"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B3261E" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>