<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Botão para sair e voltar ao login -->
    <Button
        android:id="@+id/btnSair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sair"
        android:backgroundTint="#C62828"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Painel ADM - Ordens de Serviço"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"/>

    <!-- Botão para a tela de produtos (só o ADM vê esta tela) -->
    <Button
        android:id="@+id/btnGerenciarProdutos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gerenciar Produtos"
        android:backgroundTint="#607D8B"
        android:layout_marginBottom="12dp"/>

    <!-- Barra de Filtros por Status -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFiltroTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFiltroPendente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendente"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFiltroConfirmado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmado"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFiltroConcluido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Concluído"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Lista de Ordens -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewOrdens"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>